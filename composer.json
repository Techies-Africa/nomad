{
  "name": "techies-africa/nomad",
  "description": "Automatic UTC-to-user-timezone conversion for Laravel Eloquent models",
  "keywords": ["time", "date", "datetime", "timezone", "laravel", "nomad", "techies africa", "utc"],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Joel Omojefe",
      "email": "joelomojefe@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/database": "^10.0|^11.0",
    "nesbot/carbon": "^2.0|^3.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.23|^9.0",
    "phpunit/phpunit": "^10.5",
    "torann/geoip": "^3.0"
  },
  "suggest": {
    "torann/geoip": "Required for GeoIP timezone detection fallback (~^3.0)"
  },
  "autoload": {
    "psr-4": {
      "TechiesAfrica\\Nomad\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TechiesAfrica\\Nomad\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "TechiesAfrica\\Nomad\\Providers\\NomadServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-f": "vendor/bin/phpunit --filter"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
